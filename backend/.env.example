# Provider: openai (any OpenAI-compatible API), anthropic, or ollama
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=
# Comma-separated frontend origins when the frontend and API are hosted separately.
FRONTEND_ORIGINS=
# Optional: only for non-default hosts (OpenRouter, Groq, Gemini-compat, etc.)
# LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOKENS=1500
# OpenAI reasoning models need max_completion_tokens instead:
# LLM_MAX_TOKENS_PARAM=max_completion_tokens
# Leave unset unless your model supports it:
# LLM_TEMPERATURE=0.2

AI_RATE_LIMIT_PER_MINUTE=15
# Dev only: enables POST /api/ai/debug-context
AI_DEBUG_CONTEXT=false